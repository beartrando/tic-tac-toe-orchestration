APP_NAME=orchestration
OTEL_SERVICE_NAME=tic-tac-toe-orchestration
APP_ENV=uat

GRPC_PORT=50051

DATABASE_URL=postgresql://postgres:postgres@pgbouncer:6432/orchestration
DATABASE_DIRECT_URL=postgresql://postgres:postgres@postgres:5432/orchestration

SERVICE_AUTH_URL=auth:50051
SERVICE_PROFILE_URL=profile:50051
SERVICE_ENGINE_URL=engine:50051
SERVICE_BATTLE_URL=battle:50051

ACCESS_SECRET=your_access_secret

PG_BOSS_MAX=5
PG_BOSS_MAINTENANCE_INTERVAL_SECONDS=60
PG_BOSS_APPLICATION_NAME=orchestration-pg-boss

KAFKA_BROKERS=10.100.0.1:9092
KAFKA_CLIENT_ID=tic-tac-toe-orchestration-client

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=supersecret
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
PROMETHEUS_OTLP_METRICS_ENDPOINT=http://prometheus:9090/api/v1/otlp/v1/metrics
